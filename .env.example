# Directorio donde se guardan los PDFs descargados
OUTPUT_DIR=./actas

# Ruta al archivo de indice de transmision
INDEX_FILE=e14_transmission_index_2026.json

# Numero de descargas concurrentes (ajustar segun el ancho de banda disponible)
CONCURRENCY=20

# Reintentos por archivo en caso de fallo de red
RETRIES=3

# Archivo de log para registros que no pudieron descargarse
ERRORS_FILE=errors.csv

# Opcional: filtrar por estado de transmision (11 = transmitidas y confirmadas)
# STATUS_FILTER=11
